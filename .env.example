APP_NAME=ESDEP-MT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agenda
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Em producao (HTTPS), use SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
# `lax` e necessario para o retorno do Keycloak: com `strict` o cookie de sessao
# nao acompanha o redirect de volta e o login falha com InvalidStateException.
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── SSO institucional (Keycloak) ────────────────────────────────────────────
# O Keycloak responde apenas "quem e" o usuario; papeis e permissoes ficam no
# Spatie, dentro da aplicacao. Nenhum papel e lido do token.
#
# KEYCLOAK_REDIRECT_URI precisa estar cadastrado em "Valid Redirect URIs" no
# client do realm — inclusive a URL de producao, nao so a de localhost.
#
# ATENCAO (Windows/XAMPP): a troca do `code` pelo token e uma chamada
# servidor-para-servidor. Sem CA bundle configurado no php.ini (`curl.cainfo` e
# `openssl.cafile`), o login falha com "cURL error 60" mesmo com o navegador
# acessando o SSO normalmente.
KEYCLOAK_BASE_URL=https://sso.exemplo.gov.br
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI="${APP_URL}/auth/keycloak/callback"
# Para onde o Keycloak devolve o usuario apos o logout federado.
# Sem valor, usa APP_URL.
KEYCLOAK_LOGOUT_REDIRECT="${APP_URL}"

# Sincronizacao opcional com Google Calendar/Meet via conta tecnica.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_IMPERSONATE=
GOOGLE_CALENDAR_TIMEZONE=America/Cuiaba
