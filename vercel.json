{
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 3008,
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/__test",
            "dest": "/api/test.php"
        },
        {
            "src": "/__diag",
            "dest": "/api/index.php"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/favicon.svg",
            "dest": "/public/favicon.svg"
        },
        {
            "src": "/android-chrome-(.*)",
            "dest": "/public/android-chrome-$1"
        },
        {
            "src": "/apple-touch-icon.png",
            "dest": "/public/apple-touch-icon.png"
        },
        {
            "src": "/favicon-(.*).png",
            "dest": "/public/favicon-$1.png"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
